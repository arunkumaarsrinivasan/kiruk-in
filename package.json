{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "set NODE_OPTIONS=--no-deprecation && next dev --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && npm run dev",
    "build": "set NODE_OPTIONS=--no-deprecation && next build",
    "start": "set NODE_OPTIONS=--no-deprecation && next start",
    "lint": "next lint",
    "dev:trace": "set NODE_OPTIONS=--trace-deprecation && next dev --turbopack",
    "newpost": "node scripts/newpost.mjs"
  },
  "dependencies": {
    "@arcjet/next": "^1.0.0-beta.9",
    "@chenglou/pretext": "^0.0.3",
    "@fontsource-variable/playpen-sans": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/nothing-you-could-do": "^5.3.0",
    "@hackernoon/pixel-icon-library": "^1.0.6",
    "@mdx-js/mdx": "^3.1.1",
    "@neplex/vectorizer": "^0.1.0",
    "@notionhq/client": "^2.2.13",
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/supabase-js": "^2.53.0",
    "@types/three": "^0.176.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.33.0",
    "heerich": "^0.14.0",
    "lucide-react": "^0.511.0",
    "maplibre-gl": "^4.7.0",
    "next": "^15.5.7",
    "openai": "^5.1.1",
    "perfect-freehand": "^1.2.3",
    "phosphor-react": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6",
    "seedrandom": "^3.0.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.177.0",
    "zod": "^3.25.76"
