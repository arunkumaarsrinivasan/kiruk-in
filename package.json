  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/maplibre-gl": "^1.13.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/seedrandom": "^3.0.8",
    "dotenv": "^17.2.1",
    "eslint": "9.32.0",
    "eslint-config-next": "^15.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
